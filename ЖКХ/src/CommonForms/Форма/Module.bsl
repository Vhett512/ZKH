#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИтоговаяСтрока", Новый ОписаниеТипов("Строка")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОжидаемаяСуммаСтрока", Новый ОписаниеТипов("Строка")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НачисленнаяСуммаСтрока", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	КомандаОбновить = Команды.Добавить("ПК_Обновить");
	КомандаОбновить.Заголовок = "Обновить данные";
	КомандаОбновить.Действие = "ОбновитьДанные";
	
	НоваяКнопка = Элементы.Добавить("Обновить", Тип("КнопкаФормы"));
	НоваяКнопка.ИмяКоманды = "ПК_Обновить";
	
	// Строит элементы по свежим данным из базы и заполняет итоговую строку.
	ОбновитьПоказанияНаСервере();
	
	ГруппаИтогов = Элементы.Добавить("ГруппаИтогов", Тип("ГруппаФормы"));
	ГруппаИтогов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаИтогов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	НовыйЭлементИтогов = Элементы.Добавить("ПоследниеПоказания", Тип("ПолеФормы"), ГруппаИтогов);
	НовыйЭлементИтогов.ПутьКДанным = "ИтоговаяСтрока";
	НовыйЭлементИтогов.Заголовок = "Последние показания";
	НовыйЭлементИтогов.Шрифт = ШрифтыСтиля.ЗаголовокЧетвертогоУровня;
	
	НовыйЭлементОжидаемойСуммы = Элементы.Добавить("ОжидаемаяСумма", Тип("ПолеФормы"), ГруппаИтогов);
	НовыйЭлементОжидаемойСуммы.ПутьКДанным = "ОжидаемаяСуммаСтрока";
	НовыйЭлементОжидаемойСуммы.Заголовок = "Ожидаемая сумма";
	НовыйЭлементОжидаемойСуммы.Шрифт = ШрифтыСтиля.ЗаголовокЧетвертогоУровня;
	
	НовыйЭлементНачисленнойСуммы = Элементы.Добавить("НачисленнаяСумма", Тип("ПолеФормы"), ГруппаИтогов);
	НовыйЭлементНачисленнойСуммы.ПутьКДанным = "НачисленнаяСуммаСтрока";
	НовыйЭлементНачисленнойСуммы.Заголовок = "Начисленная сумма";
	НовыйЭлементНачисленнойСуммы.Шрифт = ШрифтыСтиля.ЗаголовокЧетвертогоУровня;
	
	ОбновитьВидимостьНачисленнойСуммы();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перечитывает показания из базы и синхронно приводит состав элементов формы в соответствие
// с полученными данными: добавляет отсутствующие приборы, удаляет исчезнувшие, обновляет значения и цвета.
//
&НаСервере
Процедура ОбновитьПоказанияНаСервере()
	
	РезультатЗапроса.Загрузить(ПолучитьЗначения());
	
	// Имена элементов приборов: ПриборУчета -> имя элемента формы.
	ИменаЭлементов = ИменаЭлементовПриборов();
	
	// Имена элементов приборов, присутствующих в свежей выборке.
	ИменаПриборовВДанных = Новый Соответствие;
	Для каждого КлючИЗначение Из ИменаЭлементов Цикл
		ИменаПриборовВДанных.Вставить(КлючИЗначение.Значение, Истина);
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;
	ИменаСуществующихРеквизитов = Новый Соответствие;
	
	// Удаляем реквизиты и группы приборов, которых больше нет в данных.
	Для каждого РеквизитФормы Из ПолучитьРеквизиты() Цикл
		
		ИмяРеквизита = РеквизитФормы.Имя;
		ИменаСуществующихРеквизитов.Вставить(ИмяРеквизита, Истина);
		
		Если Лев(ИмяРеквизита, 3) <> "ПУ_" Или ИменаПриборовВДанных[ИмяРеквизита] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УдаляемыеРеквизиты.Добавить(ИмяРеквизита);
		УдаляемыеРеквизиты.Добавить("Оборот" + ИмяРеквизита);
		УдаляемыеРеквизиты.Добавить("СреднееЗначение" + ИмяРеквизита);
		УдаляемыеРеквизиты.Добавить("Процент" + ИмяРеквизита);
		
		ГруппаПрибора = Элементы.Найти("Группа_" + ИмяРеквизита);
		Если ГруппаПрибора <> Неопределено Тогда
			Элементы.Удалить(ГруппаПрибора);
		КонецЕсли;
		
	КонецЦикла;
	
	// Добавляем реквизиты для приборов, которых еще нет на форме.
	ДобавленныеПриборы = Новый Соответствие;
	Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
		
		ИмяЭлемента = ИменаЭлементов[СтрокаРезультата.ПриборУчета];
		
		Если ИменаСуществующихРеквизитов[ИмяЭлемента] <> Неопределено
			Или ДобавленныеПриборы[ИмяЭлемента] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавленныеПриборы.Вставить(ИмяЭлемента, Истина);
		ДобавляемыеРеквизиты.Добавить(
			Новый РеквизитФормы(ИмяЭлемента, Новый ОписаниеТипов("СправочникСсылка.ПриборыУчета")));
		ДобавляемыеРеквизиты.Добавить(
			Новый РеквизитФормы("Оборот" + ИмяЭлемента, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3))));
		ДобавляемыеРеквизиты.Добавить(
			Новый РеквизитФормы("СреднееЗначение" + ИмяЭлемента, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3))));
		ДобавляемыеРеквизиты.Добавить(
			Новый РеквизитФормы("Процент" + ИмяЭлемента, Новый ОписаниеТипов("Строка")));
		
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
	
	// Создаем недостающие элементы и заполняем значения.
	ИменаГруппПоТипамРесурсов = Новый Соответствие;
	
	Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
		
		ИмяЭлемента = ИменаЭлементов[СтрокаРезультата.ПриборУчета];
		ИмяГруппыТипа = ОбеспечитьГруппуТипаРесурса(СтрокаРезультата.ТипРесурса, ИменаГруппПоТипамРесурсов);
		
		ИмяГруппыПрибора = "Группа_" + ИмяЭлемента;
		Если Элементы.Найти(ИмяГруппыПрибора) = Неопределено Тогда
			
			ГруппаПрибора = Элементы.Добавить(ИмяГруппыПрибора, Тип("ГруппаФормы"), Элементы[ИмяГруппыТипа]);
			ГруппаПрибора.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаПрибора.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			
			ПолеПрибор = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаПрибора);
			ПолеПрибор.ПутьКДанным = ИмяЭлемента;
			ПолеПрибор.Заголовок = "Прибор учета";
			
			ПолеОборот = Элементы.Добавить("Оборот" + ИмяЭлемента, Тип("ПолеФормы"), ГруппаПрибора);
			ПолеОборот.ПутьКДанным = "Оборот" + ИмяЭлемента;
			ПолеОборот.Заголовок = "Оборот";
			ПолеОборот.Формат = "ЧДЦ=1";
			
			ПолеСреднее = Элементы.Добавить("СреднееЗначение" + ИмяЭлемента, Тип("ПолеФормы"), ГруппаПрибора);
			ПолеСреднее.ПутьКДанным = "СреднееЗначение" + ИмяЭлемента;
			ПолеСреднее.Заголовок = "Среднее значение";
			ПолеСреднее.Формат = "ЧДЦ=1";
			
			ПолеПроцент = Элементы.Добавить("Процент" + ИмяЭлемента, Тип("ПолеФормы"), ГруппаПрибора);
			ПолеПроцент.ПутьКДанным = "Процент" + ИмяЭлемента;
			ПолеПроцент.Заголовок = "Процент";
			
		КонецЕсли;
		
		ЭтотОбъект[ИмяЭлемента] = СтрокаРезультата.ПриборУчета;
		ЭтотОбъект["Оборот" + ИмяЭлемента] = СтрокаРезультата.Оборот;
		ЭтотОбъект["СреднееЗначение" + ИмяЭлемента] = СтрокаРезультата.СреднееЗначение;
		ЭтотОбъект["Процент" + ИмяЭлемента] = Формат(СтрокаРезультата.Процент, "ЧДЦ=1; ЧН=0") + "%";
		
		УстановитьЦветаПоказаний(ИмяЭлемента, СтрокаРезультата.Оборот, СтрокаРезультата.СреднееЗначение);
		
	КонецЦикла;
	
	СформироватьИтоговуюСтроку();
	СформироватьСтрокуОжидаемойСуммы();
	
КонецПроцедуры

// Возвращает имя группы формы для типа ресурса, создавая группу при ее отсутствии.
// Для незаполненного типа ресурса возвращает группу "Прочие".
//
// Параметры:
//  СсылкаТипаРесурса - СправочникСсылка.ТипыРесурсов - тип ресурса.
//  КэшИмен - Соответствие из СправочникСсылка.ТипыРесурсов, Строка - кэш "тип ресурса - имя группы"
//            в рамках одного построения формы.
//
// Возвращаемое значение:
//  Строка - имя элемента формы.
//
&НаСервере
Функция ОбеспечитьГруппуТипаРесурса(СсылкаТипаРесурса, КэшИмен)
	
	Если Не ЗначениеЗаполнено(СсылкаТипаРесурса) Тогда
		Возврат ИмяГруппыПрочихРесурсов();
	КонецЕсли;
	
	ИмяГруппы = КэшИмен[СсылкаТипаРесурса];
	Если ИмяГруппы = Неопределено Тогда
		ИмяГруппы = ИмяГруппыТипаРесурса(СсылкаТипаРесурса);
		КэшИмен.Вставить(СсылкаТипаРесурса, ИмяГруппы);
	КонецЕсли;
	
	Если Элементы.Найти(ИмяГруппы) = Неопределено Тогда
		Группа = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"));
		Группа.Заголовок = СсылкаТипаРесурса.Наименование;
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КонецЕсли;
	
	Возврат ИмяГруппы;
	
КонецФункции

// Окрашивает поля оборота и процента прибора в зависимости от сравнения со средним значением.
//
// Параметры:
//  ИмяЭлемента - Строка - имя реквизита/элемента прибора учета.
//  Оборот - Число - потребление за период.
//  СреднееЗначение - Число - среднее потребление за год.
//
&НаСервере
Процедура УстановитьЦветаПоказаний(ИмяЭлемента, Оборот, СреднееЗначение)
	
	ПолеОборот = Элементы["Оборот" + ИмяЭлемента];
	ПолеПроцент = Элементы["Процент" + ИмяЭлемента];
	
	ПолеОборот.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
	ПолеПроцент.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
	
	Если Оборот < СреднееЗначение Тогда
		
		ПолеОборот.ЦветТекста = WebЦвета.Зеленый;
		ПолеПроцент.ЦветТекста = WebЦвета.Зеленый;
		
	ИначеЕсли Оборот > СреднееЗначение Тогда
		
		ПолеОборот.ЦветТекста = WebЦвета.Коралловый;
		ПолеПроцент.ЦветТекста = WebЦвета.Коралловый;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьИтоговуюСтроку()
	
	ПоследнийДень = ПолучитьДату();
	СекСутки = 86400; // Секунд в сутках
	День = Цел((НачалоДня(ТекущаяДатаСеанса()) - НачалоДня(ПоследнийДень)) / СекСутки);
	ЭтотОбъект.ИтоговаяСтрока = ?(
		ПоследнийДень = '00010101',
		"Нет показаний",
		"Прошло " + День + " дней с последней даты.");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДату()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	УчетПоказаний.Дата КАК Дата
	               |ИЗ
	               |	Документ.УчетПоказаний КАК УчетПоказаний
	               |ГДЕ
	               |	УчетПоказаний.Проведен = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат Результат[0].Дата;
	
КонецФункции

// Формирует строку ожидаемой суммы начислений за месяц последних переданных показаний.
//
&НаСервере
Процедура СформироватьСтрокуОжидаемойСуммы()
	
	ПоследнийДень = ПолучитьДату();
	
	Если ПоследнийДень = Дата(1, 1, 1) Тогда
		
		ЭтотОбъект.ОжидаемаяСуммаСтрока = "Ожидаемая сумма: нет показаний";
		ЭтотОбъект.НачисленнаяСуммаСтрока = "";
		ОбновитьВидимостьНачисленнойСуммы();
		Возврат;
		
	КонецЕсли;
	
	НазваниеМесяца = НРег(НазваниеМесяцаПрописью(Месяц(ПоследнийДень)));
	Сумма = ПолучитьОжидаемуюСумму();
	
	ЭтотОбъект.ОжидаемаяСуммаСтрока = СтрШаблон(
		"за %1 месяц - %2",
		НазваниеМесяца,
		Формат(Сумма, "ЧДЦ=2; ЧН=0"));
	
	НачисленнаяСумма = ПолучитьНачисленнуюСуммуЗаМесяц(НачалоМесяца(ПоследнийДень));
	ЭтотОбъект.НачисленнаяСуммаСтрока = ?(
		НачисленнаяСумма = Неопределено,
		"",
		СтрШаблон("начисленная сумма %1", Формат(НачисленнаяСумма, "ЧДЦ=2; ЧН=0")));
	
	ОбновитьВидимостьНачисленнойСуммы();
	
КонецПроцедуры

// Скрывает элемент "НачисленнаяСумма", если начисления за месяц не найдены.
//
&НаСервере
Процедура ОбновитьВидимостьНачисленнойСуммы()
	
	Элемент = Элементы.Найти("НачисленнаяСумма");
	Если Элемент <> Неопределено Тогда
		ИмяРеквизита = "НачисленнаяСуммаСтрока";
		Элемент.Видимость = ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизита]);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает сумму начислений по документам "ВыставленныеСчета" за указанный месяц.
//
// Параметры:
//  НачалоМесяцаНачислений - Дата - начало месяца, за который запрашиваются начисления.
//
// Возвращаемое значение:
//  Число, Неопределено - сумма начислений; Неопределено, если за месяц нет проведенных документов.
//
&НаСервере
Функция ПолучитьНачисленнуюСуммуЗаМесяц(НачалоМесяцаНачислений)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Услуги.Начислено) КАК Начислено,
	|	КОЛИЧЕСТВО(Услуги.Ссылка) КАК КоличествоСтрок
	|ИЗ
	|	Документ.ВыставленныеСчета.Услуги КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка.Проведен
	|	И НАЧАЛОПЕРИОДА(Услуги.Ссылка.Дата, МЕСЯЦ) = &НачалоМесяцаНачислений";
	
	Запрос.УстановитьПараметр("НачалоМесяцаНачислений", НачалоМесяцаНачислений);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Или Результат[0].КоличествоСтрок = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат[0].Начислено;
	
КонецФункции

// Возвращает название месяца прописью в именительном падеже.
//
// Параметры:
//  НомерМесяца - Число - номер месяца (1-12).
//
// Возвращаемое значение:
//  Строка - название месяца, например "Октябрь".
//
&НаСервере
Функция НазваниеМесяцаПрописью(НомерМесяца)
	
	НазванияМесяцев = Новый Массив;
	НазванияМесяцев.Добавить("Январь");
	НазванияМесяцев.Добавить("Февраль");
	НазванияМесяцев.Добавить("Март");
	НазванияМесяцев.Добавить("Апрель");
	НазванияМесяцев.Добавить("Май");
	НазванияМесяцев.Добавить("Июнь");
	НазванияМесяцев.Добавить("Июль");
	НазванияМесяцев.Добавить("Август");
	НазванияМесяцев.Добавить("Сентябрь");
	НазванияМесяцев.Добавить("Октябрь");
	НазванияМесяцев.Добавить("Ноябрь");
	НазванияМесяцев.Добавить("Декабрь");
	
	Возврат НазванияМесяцев[НомерМесяца - 1];
	
КонецФункции

// Возвращает общую ожидаемую сумму начислений по всем ресурсам за последний период показаний.
//
// Возвращаемое значение:
//  Число - общая сумма начислений.
//
&НаСервере
Функция ПолучитьОжидаемуюСумму()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ПоказанияСрезПоследних.Период) КАК Период
	|ПОМЕСТИТЬ ПоследнийПериод
	|ИЗ
	|	РегистрСведений.Показания.СрезПоследних КАК ПоказанияСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ПотреблениеРесурсов.Период, МЕСЯЦ) КАК Период,
	|	ПотреблениеРесурсов.ПриборУчета КАК ПриборУчета,
	|	ПотреблениеРесурсов.Ресурс КАК Ресурс,
	|	СУММА(ПотреблениеРесурсов.ПотреблениеРесурса) КАК ПотреблениеРесурсаОборот
	|ПОМЕСТИТЬ ПотреблениеРесурсовПоСчетчикам
	|ИЗ
	|	РегистрНакопления.ПотреблениеРесурсов КАК ПотреблениеРесурсов
	|ГДЕ
	|	ПотреблениеРесурсов.Источник = &ИсточникПоказаний
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ПотреблениеРесурсов.Период, МЕСЯЦ),
	|	ПотреблениеРесурсов.ПриборУчета,
	|	ПотреблениеРесурсов.Ресурс
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПриборУчета,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТарифыСрезПоследних.РесурсУслуга КАК РесурсУслуга,
	|	ТарифыСрезПоследних.Тариф КАК Тариф,
	|	ВЫБОР
	|		КОГДА ВидыРесурсов.Тип = &Общая
	|			ТОГДА ТарифыСрезПоследних.Тариф
	|		КОГДА ВидыРесурсов.Тип = &Индивидуальная
	|			ТОГДА ТарифыСрезПоследних.Тариф * ОбъектыНедвижимости.ПлощадьОбщая
	|	КОНЕЦ КАК Сумма,
	|	ОбъектыНедвижимостиИспользуемыеВидыРесурсов.Ссылка КАК Недвижимость
	|ПОМЕСТИТЬ ПоНормативу
	|ИЗ
	|	Справочник.ОбъектыНедвижимости.ИспользуемыеВидыРесурсов КАК ОбъектыНедвижимостиИспользуемыеВидыРесурсов
	|		// Внутреннее соединение и отбор по типу вида ресурса эквивалентны исходному
	|		// левому соединению с условием по типу услуги: строки без тарифа не участвуют.
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Тарифы.СрезПоследних КАК ТарифыСрезПоследних
	|		ПО (ТарифыСрезПоследних.РесурсУслуга = ОбъектыНедвижимостиИспользуемыеВидыРесурсов.ВидРесурса)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыНедвижимости КАК ОбъектыНедвижимости
	|		ПО ОбъектыНедвижимости.Ссылка = ОбъектыНедвижимостиИспользуемыеВидыРесурсов.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов
	|		ПО ВидыРесурсов.Ссылка = ОбъектыНедвижимостиИспользуемыеВидыРесурсов.ВидРесурса
	|ГДЕ
	|	ВидыРесурсов.Тип = &Общая
	|	ИЛИ ВидыРесурсов.Тип = &Индивидуальная
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсУслуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоказанияСрезПоследних.Период КАК Период,
	|	ПоказанияСрезПоследних.Недвижимость КАК Недвижимость,
	|	ПоказанияСрезПоследних.ПриборУчета КАК ПриборУчета,
	|	ПоказанияСрезПоследних.Ресурс КАК Ресурс,
	|	ПотреблениеРесурсовОбороты.ПотреблениеРесурсаОборот КАК ПотреблениеРесурсаОборот,
	|	ТарифыИнтервальный.Тариф КАК Тариф,
	|	ПотреблениеРесурсовОбороты.ПотреблениеРесурсаОборот * ТарифыИнтервальный.Тариф КАК Сумма,
	|	ТарифыИнтервальный.РесурсУслуга КАК РесурсУслуга,
	|	ТарифыИнтервальный.ДатаНачала КАК ДатаНачала,
	|	ТарифыИнтервальный.ДатаОкончания КАК ДатаОкончания,
	|	ПоказанияСрезПоследних.Ресурс КАК Ресурс1,
	|	ТарифыИнтервальный.РесурсУслуга КАК РесурсУслуга1
	|ПОМЕСТИТЬ ПоСчетчику
	|ИЗ
	|	ПоследнийПериод КАК ПоследнийПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Показания.СрезПоследних КАК ПоказанияСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыНедвижимости.ИспользуемыеВидыРесурсов КАК ОбъектыНедвижимостиИспользуемыеВидыРесурсов
	|			ПО ПоказанияСрезПоследних.Недвижимость = ОбъектыНедвижимостиИспользуемыеВидыРесурсов.Ссылка
	|				И ПоказанияСрезПоследних.Ресурс = ОбъектыНедвижимостиИспользуемыеВидыРесурсов.ВидРесурса
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПотреблениеРесурсовПоСчетчикам КАК ПотреблениеРесурсовОбороты
	|			ПО (ПотреблениеРесурсовОбороты.ПриборУчета = ПоказанияСрезПоследних.ПриборУчета)
	|				И (НАЧАЛОПЕРИОДА(ПоказанияСрезПоследних.Период, МЕСЯЦ) = ПотреблениеРесурсовОбороты.Период)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифыИнтервальный КАК ТарифыИнтервальный
	|			ПО (ПоказанияСрезПоследних.Период МЕЖДУ ТарифыИнтервальный.ДатаНачала И ВЫБОР
	|					КОГДА ТарифыИнтервальный.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА ДАТАВРЕМЯ(3999, 12, 31)
	|					ИНАЧЕ ТарифыИнтервальный.ДатаОкончания
	|				КОНЕЦ)
	|				И (ТарифыИнтервальный.РесурсУслуга = ПоказанияСрезПоследних.Ресурс)
	|		ПО (ПоказанияСрезПоследних.Период = ПоследнийПериод.Период)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ресурс,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоСчетчику.Период КАК Период,
	|	ПоСчетчику.Недвижимость КАК Недвижимость,
	|	ЗНАЧЕНИЕ(Справочник.ПриборыУчета.ПустаяСсылка) КАК ПриборУчета,
	|	МАКСИМУМ(&Водоотведение) КАК Ресурс,
	|	СУММА(ПоСчетчику.ПотреблениеРесурсаОборот) КАК ПотреблениеРесурсаОборот,
	|	ТарифыИнтервальный.Тариф КАК Тариф,
	|	СУММА(ПоСчетчику.ПотреблениеРесурсаОборот * ТарифыИнтервальный.Тариф) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Водоотведение
	|ИЗ
	|	ПоСчетчику КАК ПоСчетчику
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов
	|		ПО ВидыРесурсов.Ссылка = ПоСчетчику.Ресурс
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифыИнтервальный КАК ТарифыИнтервальный
	|		ПО (ПоСчетчику.Период МЕЖДУ ТарифыИнтервальный.ДатаНачала И ВЫБОР
	|				КОГДА ТарифыИнтервальный.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(3999, 12, 31)
	|				ИНАЧЕ ТарифыИнтервальный.ДатаОкончания
	|			КОНЕЦ)
	|			И (ТарифыИнтервальный.РесурсУслуга = &Водоотведение)
	|ГДЕ
	|	ВидыРесурсов.Тип = &Тип
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоСчетчику.Период,
	|	ПоСчетчику.Недвижимость,
	|	ТарифыИнтервальный.Тариф
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ресурс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТарифыИнтервальный.РесурсУслуга КАК РесурсУслуга,
	|	ПоследнийПериод.Период КАК Период,
	|	ТарифыИнтервальный.Тариф КАК Тариф
	|ПОМЕСТИТЬ ОстальныеТарифы
	|ИЗ
	|	ПоследнийПериод КАК ПоследнийПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифыИнтервальный КАК ТарифыИнтервальный
	|		ПО (ПоследнийПериод.Период МЕЖДУ ТарифыИнтервальный.ДатаНачала И ВЫБОР
	|				КОГДА ТарифыИнтервальный.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(3999, 12, 31)
	|				ИНАЧЕ ТарифыИнтервальный.ДатаОкончания
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПоСчетчику КАК ПоСчетчику
	|		ПО ТарифыИнтервальный.РесурсУслуга = ПоСчетчику.Ресурс
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов
	|		ПО ВидыРесурсов.Ссылка = ТарифыИнтервальный.РесурсУслуга
	|ГДЕ
	|	ВидыРесурсов.ПорядокРасчета = &ПорядокРасчета
	|	И ПоСчетчику.Ресурс ЕСТЬ NULL
	|	И НЕ ТарифыИнтервальный.РесурсУслуга = &Водоотведение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсУслуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстальныеТарифы.РесурсУслуга КАК РесурсУслуга,
	|	СРЕДНЕЕ(ПотреблениеРесурсов.ПотреблениеРесурса) КАК ПотреблениеРесурса
	|ПОМЕСТИТЬ СреднееПоследнихРесурсов
	|ИЗ
	|	ОстальныеТарифы КАК ОстальныеТарифы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПотреблениеРесурсов КАК ПотреблениеРесурсов
	|		ПО ОстальныеТарифы.РесурсУслуга = ПотреблениеРесурсов.Ресурс
	|			И (МЕСЯЦ(ОстальныеТарифы.Период) = МЕСЯЦ(ПотреблениеРесурсов.Период))
	|			И (ПотреблениеРесурсов.Источник = &ИсточникСчетов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстальныеТарифы.РесурсУслуга,
	|	МЕСЯЦ(ОстальныеТарифы.Период)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсУслуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстальныеТарифы.РесурсУслуга КАК РесурсУслуга,
	|	ОстальныеТарифы.Тариф КАК Тариф,
	|	СреднееПоследнихРесурсов.ПотреблениеРесурса КАК ПотреблениеРесурса,
	|	ОстальныеТарифы.Тариф * СреднееПоследнихРесурсов.ПотреблениеРесурса КАК СреднееЗначениеСуммы
	|ПОМЕСТИТЬ СреднееЗначениеНеконролируемых
	|ИЗ
	|	ОстальныеТарифы КАК ОстальныеТарифы
	|		ЛЕВОЕ СОЕДИНЕНИЕ СреднееПоследнихРесурсов КАК СреднееПоследнихРесурсов
	|		ПО ОстальныеТарифы.РесурсУслуга = СреднееПоследнихРесурсов.РесурсУслуга
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсУслуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоНормативу.РесурсУслуга КАК РесурсУслуга,
	|	ПоНормативу.Тариф КАК Тариф,
	|	ПоНормативу.Сумма КАК Сумма,
	|	ВидыРесурсов.ОДН КАК ОДН
	|ПОМЕСТИТЬ ИтоговыеНачисления
	|ИЗ
	|	ПоНормативу КАК ПоНормативу
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов
	|		ПО ВидыРесурсов.Ссылка = ПоНормативу.РесурсУслуга
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоСчетчику.Ресурс,
	|	ПоСчетчику.Тариф,
	|	ПоСчетчику.Сумма,
	|	ВидыРесурсов.ОДН
	|ИЗ
	|	ПоСчетчику КАК ПоСчетчику
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов
	|		ПО ВидыРесурсов.Ссылка = ПоСчетчику.Ресурс
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Водоотведение.Ресурс,
	|	ВТ_Водоотведение.Тариф,
	|	ВТ_Водоотведение.Сумма,
	|	ЛОЖЬ
	|ИЗ
	|	ВТ_Водоотведение КАК ВТ_Водоотведение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СреднееЗначениеНеконролируемых.РесурсУслуга,
	|	СреднееЗначениеНеконролируемых.Тариф,
	|	СреднееЗначениеНеконролируемых.СреднееЗначениеСуммы,
	|	ВидыРесурсов.ОДН
	|ИЗ
	|	СреднееЗначениеНеконролируемых КАК СреднееЗначениеНеконролируемых
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов
	|		ПО ВидыРесурсов.Ссылка = СреднееЗначениеНеконролируемых.РесурсУслуга
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РесурсУслуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ИтоговыеНачисления.Сумма), 0) КАК Итого
	|ИЗ
	|	ИтоговыеНачисления КАК ИтоговыеНачисления";
	
	Запрос.УстановитьПараметр("Тип", Справочники.ТипыРесурсов.Вода);
	Запрос.УстановитьПараметр("ПорядокРасчета", Перечисления.ВидыРасчетов.ПоСчетчику);
	Запрос.УстановитьПараметр("ИсточникПоказаний", Перечисления.ИсточникиПотребления.ПоказанияПриборов);
	Запрос.УстановитьПараметр("ИсточникСчетов", Перечисления.ИсточникиПотребления.ВыставленныеСчета);
	Запрос.УстановитьПараметр("Общая", Справочники.ТипыРесурсов.ПолучитьСсылку(Новый УникальныйИдентификатор("5C3C3EED-71FD-11F1-A7B0-001986003A27")));
	Запрос.УстановитьПараметр("Индивидуальная", Справочники.ТипыРесурсов.ПолучитьСсылку(Новый УникальныйИдентификатор("7F86FFE3-71FC-11F1-A7B0-001986003A27")));
	Запрос.УстановитьПараметр("Водоотведение", ПланыВидовХарактеристик.ВидыРесурсов.ПолучитьСсылку(Новый УникальныйИдентификатор("5C3C3EE6-71FD-11F1-A7B0-001986003A27")));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Результат[0].Итого;
	
КонецФункции

//@skip-check module-unused-method
&НаКлиенте
Процедура ОбновитьДанные(Команда)
	
	ОбновитьПоказанияНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(ПоказанияСрезПоследних.Период) КАК Период
	|ПОМЕСТИТЬ МаксимальныйПериод
	|ИЗ
	|	РегистрСведений.Показания.СрезПоследних КАК ПоказанияСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПотреблениеРесурсовОбороты.ПриборУчета КАК ПриборУчета,
	|	СРЕДНЕЕ(ПотреблениеРесурсовОбороты.ПотреблениеРесурсаОборот) КАК СреднееЗначение
	|ПОМЕСТИТЬ СреднееЗаГод
	|ИЗ
	|	МаксимальныйПериод КАК МаксимальныйПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПотреблениеРесурсов.Обороты(,, Месяц, Источник = &ИсточникПоказаний) КАК ПотреблениеРесурсовОбороты
	|		ПО ПотреблениеРесурсовОбороты.Период МЕЖДУ НАЧАЛОПЕРИОДА(МаксимальныйПериод.Период, ГОД) И МаксимальныйПериод.Период
	|СГРУППИРОВАТЬ ПО
	|	ПотреблениеРесурсовОбороты.ПриборУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПриборУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПотреблениеРесурсовОбороты.Период КАК Период,
	|	ПотреблениеРесурсовОбороты.ПриборУчета КАК ПриборУчета,
	|	ПриборыУчета.Код КАК КодПрибораУчета,
	|	ВидыРесурсов.Тип КАК ТипРесурса,
	|	ПотреблениеРесурсовОбороты.ПотреблениеРесурсаОборот КАК Оборот,
	|	СреднееЗаГод.СреднееЗначение КАК СреднееЗначение,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СреднееЗаГод.СреднееЗначение, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ПотреблениеРесурсовОбороты.ПотреблениеРесурсаОборот / СреднееЗаГод.СреднееЗначение * 100
	|	КОНЕЦ КАК Процент
	|ИЗ
	|	РегистрНакопления.ПотреблениеРесурсов.Обороты(,, Месяц, Источник = &ИсточникПоказаний) КАК ПотреблениеРесурсовОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Показания.СрезПоследних КАК ПоказанияСрезПоследних
	|		ПО ПотреблениеРесурсовОбороты.Период = ПоказанияСрезПоследних.Период
	|		И ПотреблениеРесурсовОбороты.ПриборУчета = ПоказанияСрезПоследних.ПриборУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МаксимальныйПериод КАК МаксимальныйПериод
	|		ПО МаксимальныйПериод.Период = ПотреблениеРесурсовОбороты.Период
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СреднееЗаГод КАК СреднееЗаГод
	|		ПО ПотреблениеРесурсовОбороты.ПриборУчета = СреднееЗаГод.ПриборУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПриборыУчета КАК ПриборыУчета
	|		ПО ПриборыУчета.Ссылка = ПотреблениеРесурсовОбороты.ПриборУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов
	|		ПО ВидыРесурсов.Ссылка = ПриборыУчета.ВидРесурса
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыРесурсов.Тип";
	Запрос.УстановитьПараметр("ИсточникПоказаний", Перечисления.ИсточникиПотребления.ПоказанияПриборов);
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции

// Возвращает имя группы формы для типа ресурса.
// Имя строится из кода (уникален и допустим), при пустом коде - из GUID без разделителей.
// Одно и то же значение используется и при создании группы, и при ее поиске.
//
// Параметры:
//  СсылкаТипаРесурса - СправочникСсылка.ТипыРесурсов - тип ресурса.
//
// Возвращаемое значение:
//  Строка - имя элемента формы.
//
&НаСервере
Функция ИмяГруппыТипаРесурса(СсылкаТипаРесурса)
	
	Ключ = "";
	Если ЗначениеЗаполнено(СсылкаТипаРесурса) Тогда
		Ключ = СокрЛП(Строка(СсылкаТипаРесурса.Код));
	КонецЕсли;
	
	Если ПустаяСтрока(Ключ) Тогда
		Ключ = СтрЗаменить(Строка(СсылкаТипаРесурса.УникальныйИдентификатор()), "-", "");
	КонецЕсли;
	
	Возврат "Группа_" + Ключ;
	
КонецФункции

// Формирует имена элементов формы для приборов учета по данным РезультатЗапроса.
// Имя строится из кода прибора; при совпадении кодов (в том числе пустых) к имени
// добавляется GUID прибора, чтобы имена элементов оставались уникальными.
//
// Возвращаемое значение:
//  Соответствие из СправочникСсылка.ПриборыУчета, Строка - имя элемента формы по прибору учета.
//
&НаСервере
Функция ИменаЭлементовПриборов()
	
	КоличествоПоКоду = Новый Соответствие;
	Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
		Код = КодПрибораУчетаВИмени(СтрокаРезультата.КодПрибораУчета);
		КоличествоПоКоду.Вставить(Код, ?(КоличествоПоКоду[Код] = Неопределено, 1, КоличествоПоКоду[Код] + 1));
	КонецЦикла;
	
	Имена = Новый Соответствие;
	Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
		
		Код = КодПрибораУчетаВИмени(СтрокаРезультата.КодПрибораУчета);
		Имя = "ПУ_" + Код;
		
		Если КоличествоПоКоду[Код] > 1 Тогда
			УникальныйКлюч = СтрЗаменить(Строка(СтрокаРезультата.ПриборУчета.УникальныйИдентификатор()), "-", "");
			Имя = Имя + "_" + УникальныйКлюч;
		КонецЕсли;
		
		Имена.Вставить(СтрокаРезультата.ПриборУчета, Имя);
		
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Возвращает код прибора учета, пригодный для использования в имени элемента формы.
//
// Параметры:
//  КодПрибораУчета - Строка - код прибора учета.
//
// Возвращаемое значение:
//  Строка - код прибора учета, для пустого кода - "БезКода".
//
&НаСервере
Функция КодПрибораУчетаВИмени(КодПрибораУчета)
	
	Ключ = СокрЛП(Строка(КодПрибораУчета));
	Если ПустаяСтрока(Ключ) Тогда
		Ключ = "БезКода";
	КонецЕсли;
	
	Возврат Ключ;
	
КонецФункции

// Создает (однократно) группу для типов ресурсов, не найденных в справочнике.
//
// Возвращаемое значение:
//  Строка - имя элемента формы.
//
&НаСервере
Функция ИмяГруппыПрочихРесурсов()
	
	Имя = "Группа_Прочие";
	Если Элементы.Найти(Имя) = Неопределено Тогда
		Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
		Группа.Заголовок = "Прочие";
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КонецЕсли;
	
	Возврат Имя;
	
КонецФункции

#КонецОбласти
