//
Процедура ПриЗаписи(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ТарифыЖКХ.ПерестроитьИнтервалыТарифов();

КонецПроцедуры

#КонецОбласти
