#Область ОбработчикиСобытий

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РесурсыУслуг = Новый Массив;
	
	Если Количество() = 0 Тогда
		// Удаление набора записей
		РесурсыУслуг.Добавить(Отбор.РесурсУслуга.Значение);
	Иначе
		Для Каждого ЗаписьРегистра Из ЭтотОбъект Цикл
			Если РесурсыУслуг.Найти(ЗаписьРегистра.РесурсУслуга) = Неопределено Тогда
				РесурсыУслуг.Добавить(ЗаписьРегистра.РесурсУслуга);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если РесурсыУслуг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьИнтервалыТарифов(РесурсыУслуг);
	ТарифыПоРесурсам = ПрочитатьТарифыПоРесурсам(РесурсыУслуг);
	
	Для Каждого РесурсУслуга Из РесурсыУслуг Цикл
		ПерестроитьИнтервалыТарифа(РесурсУслуга, ТарифыПоРесурсам[РесурсУслуга]);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаблокироватьИнтервалыТарифов(РесурсыУслуг)
	
	Блокировка = Новый БлокировкаДанных;
	Для Каждого РесурсУслуга Из РесурсыУслуг Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТарифыИнтервальный");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("РесурсУслуга", РесурсУслуга);
	КонецЦикла;
	
	Попытка
		Блокировка.Заблокировать();
	Исключение
		// Конфликт блокировок при параллельной записи тарифов: прерываем запись,
		// причина попадает в журнал регистрации.
		ЗаписьЖурналаРегистрации(
			"ЖКХ.Блокировка тарифов",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ПрочитатьТарифыПоРесурсам(РесурсыУслуг)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Тарифы.РесурсУслуга КАК РесурсУслуга,
	|	Тарифы.Период КАК Период,
	|	Тарифы.Тариф КАК Тариф
	|ИЗ
	|	РегистрСведений.Тарифы КАК Тарифы
	|ГДЕ
	|	Тарифы.РесурсУслуга В (&РесурсыУслуг)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РесурсУслуга,
	|	Период";
	Запрос.УстановитьПараметр("РесурсыУслуг", РесурсыУслуг);
	ТаблицаТарифов = Запрос.Выполнить().Выгрузить();
	
	ТарифыПоРесурсам = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ТаблицаТарифов Цикл
		ЗаписиРесурса = ТарифыПоРесурсам[СтрокаТаблицы.РесурсУслуга];
		Если ЗаписиРесурса = Неопределено Тогда
			ЗаписиРесурса = Новый Массив;
			ТарифыПоРесурсам.Вставить(СтрокаТаблицы.РесурсУслуга, ЗаписиРесурса);
		КонецЕсли;
		ЗаписиРесурса.Добавить(СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ТарифыПоРесурсам;
	
КонецФункции

Процедура ПерестроитьИнтервалыТарифа(РесурсУслуга, ЗаписиТарифов)
	
	Набор = РегистрыСведений.ТарифыИнтервальный.СоздатьНаборЗаписей();
	// Отбор обязателен: запись идёт в режиме замещения (по умолчанию) и удаляет
	// существующие записи регистра, попадающие под отбор. Без отбора удалились бы все.
	Набор.Отбор.РесурсУслуга.Установить(РесурсУслуга);
	
	Если ЗаписиТарифов <> Неопределено Тогда
		Для Индекс = 0 По ЗаписиТарифов.Количество() - 1 Цикл
			
			Запись = Набор.Добавить();
			Запись.РесурсУслуга = РесурсУслуга;
			Запись.ДатаНачала = ЗаписиТарифов[Индекс].Период;
			Запись.Тариф = ЗаписиТарифов[Индекс].Тариф;
			
			Если Индекс < ЗаписиТарифов.Количество() - 1 Тогда
				// Конец интервала — за секунду до начала следующего
				Запись.ДатаОкончания = ЗаписиТарифов[Индекс + 1].Период - 1;
			Иначе
				// Открытый интервал — ограничиваем максимально возможной датой
				Запись.ДатаОкончания = Дата('39991231235959');
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Набор.Записать();
	
КонецПроцедуры

#КонецОбласти
