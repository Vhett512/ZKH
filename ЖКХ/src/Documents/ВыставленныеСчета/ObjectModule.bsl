#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ЗаполняемыеРеквизиты)
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		
		Отказ = Истина;
		ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не заполнен лицевой счет.'"), "ЛицевойСчет");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛицевойСчет) И ЗначениеЗаполнено(Недвижимость) Тогда
		
		Если ПотреблениеЖКХ.ОбъектНедвижимостиЛицевогоСчета(ЛицевойСчет) <> Недвижимость Тогда
			Отказ = Истина;
			ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Недвижимость не соответствует лицевому счету.'"), "Недвижимость");
		КонецЕсли;
		
	КонецЕсли;
	
	ПроверенныеУслуги = Новый Соответствие;
	Для Каждого СтрокаУслуги Из Услуги Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаУслуги.Услуга) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПроверенныеУслуги[СтрокаУслуги.Услуга] <> Неопределено Тогда
			
			Отказ = Истина;
			ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'Услуга указана в документе более одного раза.'"),
				"Услуги[" + (СтрокаУслуги.НомерСтроки - 1) + "].Услуга");
			
		Иначе
			
			ПроверенныеУслуги.Вставить(СтрокаУслуги.Услуга, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ПотреблениеРесурсов.Записывать = Истина;
	Движения.Начисления.Записывать = Истина;
	// Движения по регистру Тарифы очищаются платформой при повторном проведении
	// и при отмене проведения документа: регистр подчинен регистратору.
	Движения.Тарифы.Записывать = Истина;
	
	ПриборыУслуг = ПотреблениеЖКХ.ПриборыУчетаПоУслугам(ЛицевойСчет);
	
	Для Каждого СтрокаУслуги Из Услуги Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаУслуги.Услуга) Тогда
			Продолжить;
		КонецЕсли;
		
		// Регистр Показания не заполняется: в файле нет показаний приборов учета.
		ПриборУчета = ПриборыУслуг.Получить(СтрокаУслуги.Услуга);
		
		Движение = Движения.ПотреблениеРесурсов.Добавить();
		Движение.Период = Дата;
		Движение.Источник = Перечисления.ИсточникиПотребления.ВыставленныеСчета;
		Движение.ПриборУчета = ?(ЗначениеЗаполнено(ПриборУчета), ПриборУчета, Справочники.ПриборыУчета.ПустаяСсылка());
		Движение.Ресурс = СтрокаУслуги.Услуга;
		Движение.ПотреблениеРесурса = СтрокаУслуги.Объем;
		
		// регистр Начисления
		ДвижениеНачисления = Движения.Начисления.Добавить();
		ДвижениеНачисления.Период = Дата;
		ДвижениеНачисления.ЛицевойСчет = ЛицевойСчет;
		ДвижениеНачисления.Услуга = СтрокаУслуги.Услуга;
		ДвижениеНачисления.Сумма = СтрокаУслуги.Начислено;
		
	КонецЦикла;
	
	ЗаполнитьДвиженияТарифов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет движения регистра "Тарифы" тарифами услуг документа.
//
// Движение по услуге формируется, только если тариф отличается от тарифа, действовавшего
// до периода документа. При нулевом или неизменном тарифе движение не создается: регистр
// подчинен регистратору, поэтому отсутствие движения означает отсутствие записи за период.
//
Процедура ЗаполнитьДвиженияТарифов()
	
	ПериодТарифа = НачалоМесяца(Дата);
	
	ТарифыУслуг = Новый Соответствие;
	Для Каждого СтрокаУслуги Из Услуги Цикл
		Если ЗначениеЗаполнено(СтрокаУслуги.Услуга) Тогда
			ТарифыУслуг.Вставить(СтрокаУслуги.Услуга, СтрокаУслуги.Тариф);
		КонецЕсли;
	КонецЦикла;
	
	Если ТарифыУслуг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокУслуг = Новый Массив;
	Для Каждого КлючИЗначение Из ТарифыУслуг Цикл
		СписокУслуг.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	// Записи периода документа не учитываются: сравниваем с тарифом, действовавшим ранее.
	ДействующиеТарифы = ТарифыЖКХ.ТарифыНаДату(СписокУслуг, ПериодТарифа - 1);
	
	Для Каждого КлючИЗначение Из ТарифыУслуг Цикл
		
		РесурсУслуга = КлючИЗначение.Ключ;
		Тариф = КлючИЗначение.Значение;
		
		Если Тариф = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДействующийТариф = ДействующиеТарифы.Получить(РесурсУслуга);
		Если ДействующийТариф <> Неопределено И ДействующийТариф = Тариф Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Движения.Тарифы.Добавить();
		Запись.Период = ПериодТарифа;
		Запись.РесурсУслуга = РесурсУслуга;
		Запись.Тариф = Тариф;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
