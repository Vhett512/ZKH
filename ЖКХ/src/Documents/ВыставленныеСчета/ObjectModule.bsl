#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ЗаполняемыеРеквизиты)
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Не заполнен лицевой счет.'");
		Сообщение.Поле = "ЛицевойСчет";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ПотреблениеРесурсов.Записывать = Истина;
	
	ПриборыУчетаПоУслугам = ПриборыУчетаПоУслугам();
	
	Для Каждого СтрокаУслуги Из Услуги Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаУслуги.Услуга) Тогда
			Продолжить;
		КонецЕсли;
		
		// Регистр Показания не заполняется: в файле нет показаний приборов учета.
		Движение = Движения.ПотреблениеРесурсов.Добавить();
		Движение.Период = Дата;
		Движение.ПриборУчета = ПриборыУчетаПоУслугам[СтрокаУслуги.Услуга];
		Движение.Ресурс = СтрокаУслуги.Услуга;
		Движение.ПотреблениеРесурса = СтрокаУслуги.Объем;
		
	КонецЦикла;
	
	ОбновитьТарифы();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает соответствие "услуга - прибор учета" по данным лицевого счета документа.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Характеристика.ВидыРесурсов - услуга.
//   * Значение - СправочникСсылка.ПриборыУчета - прибор учета.
//
Функция ПриборыУчетаПоУслугам()
	
	Результат = Новый Соответствие;
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодключенныеРесурсы.ВидРесурса КАК ВидРесурса,
	|	ПодключенныеРесурсы.ПриборУчета КАК ПриборУчета
	|ИЗ
	|	Справочник.ЛицевыеСчета.ПодключенныеРесурсы КАК ПодключенныеРесурсы
	|ГДЕ
	|	ПодключенныеРесурсы.Ссылка = &ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Для Каждого СтрокаРезультата Из Запрос.Выполнить().Выгрузить() Цикл
		Если ЗначениеЗаполнено(СтрокаРезультата.ВидРесурса) Тогда
			Результат.Вставить(СтрокаРезультата.ВидРесурса, СтрокаРезультата.ПриборУчета);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Обновляет регистр сведений "Тарифы" изменениями тарифов.
//
// Запись в регистр выполняется только при изменении тарифа относительно последнего
// тарифа, действовавшего до периода документа. Если тариф не изменился, запись
// за текущий период не создается, а ранее созданная - удаляется.
//
// Нулевой тариф в регистр не записывается: запись текущего периода для такой услуги удаляется.
//
// Регистр "Тарифы" не подчинен регистратору, поэтому запись выполняется напрямую набором
// записей и не отменяется при отмене проведения документа.
//
Процедура ОбновитьТарифы()
	
	ПериодТарифа = НачалоМесяца(Дата);
	
	МассивУслуг = Новый Массив;
	Для Каждого СтрокаУслуги Из Услуги Цикл
		Если ЗначениеЗаполнено(СтрокаУслуги.Услуга)
			И МассивУслуг.Найти(СтрокаУслуги.Услуга) = Неопределено Тогда
			МассивУслуг.Добавить(СтрокаУслуги.Услуга);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивУслуг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДействующиеТарифы = ТарифыПредыдущегоПериода(МассивУслуг, ПериодТарифа);
	
	Для Каждого СтрокаУслуги Из Услуги Цикл
		
		РесурсУслуга = СтрокаУслуги.Услуга;
		
		Если НЕ ЗначениеЗаполнено(РесурсУслуга) Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.Тарифы.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РесурсУслуга.Установить(РесурсУслуга);
		НаборЗаписей.Отбор.Период.Установить(ПериодТарифа);
		
		Если СтрокаУслуги.Тариф = 0 Тогда
			// Нулевой тариф не записывается: удаляем возможную запись текущего периода.
			НаборЗаписей.Записать();
			Продолжить;
		КонецЕсли;
		
		ДействующийТариф = ДействующиеТарифы.Получить(РесурсУслуга);

		Если ДействующийТариф <> Неопределено И ДействующийТариф = СтрокаУслуги.Тариф Тогда
			// Тариф не изменился - удаляем возможную запись текущего периода.
			НаборЗаписей.Записать();
			Продолжить;
		КонецЕсли;
		
		Запись = НаборЗаписей.Добавить();
		Запись.Период = ПериодТарифа;
		Запись.РесурсУслуга = РесурсУслуга;
		Запись.Тариф = СтрокаУслуги.Тариф;
		
		НаборЗаписей.Записать(Истина);
		
		ДействующиеТарифы.Вставить(РесурсУслуга, СтрокаУслуги.Тариф);
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает соответствие "услуга - тариф", действовавшее до указанного периода.
//
// Параметры:
//  СписокУслуг - Массив из Характеристика.ВидыРесурсов - услуги, по которым запрашиваются тарифы.
//  ПериодТарифа - Дата - период (начало месяца), до которого запрашиваются тарифы.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Характеристика.ВидыРесурсов - услуга.
//   * Значение - Число - тариф, действовавший до периода.
//
Функция ТарифыПредыдущегоПериода(СписокУслуг, ПериодТарифа)
	
	// Записи периода документа не учитываются: сравниваем с тарифом, действовавшим ранее.
	ГраницаПредыдущегоПериода = ПериодТарифа - 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТарифыСрезПоследних.РесурсУслуга КАК РесурсУслуга,
	|	ТарифыСрезПоследних.Тариф КАК Тариф
	|ИЗ
	|	РегистрСведений.Тарифы.СрезПоследних(&ГраницаПредыдущегоПериода, РесурсУслуга В (&Услуги)) КАК ТарифыСрезПоследних";
	
	Запрос.УстановитьПараметр("ГраницаПредыдущегоПериода", ГраницаПредыдущегоПериода);
	Запрос.УстановитьПараметр("Услуги", СписокУслуг);
	
	Результат = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Запрос.Выполнить().Выгрузить() Цикл
		Результат.Вставить(СтрокаРезультата.РесурсУслуга, СтрокаРезультата.Тариф);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
