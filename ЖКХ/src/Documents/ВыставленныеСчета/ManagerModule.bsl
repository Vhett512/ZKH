#Область ПрограммныйИнтерфейс

// Определяет, есть ли по выставленному счету проведенная оплата.
//
// Параметры:
//  Ссылка - ДокументСсылка.ВыставленныеСчета - выставленный счет.
//  ИсключаемаяОплата - ДокументСсылка.Оплата, Неопределено - оплата, которую не нужно
//                      учитывать (например, отменяемая или удаляемая).
//
// Возвращаемое значение:
//  Булево - Истина, если есть хотя бы одна проведенная оплата с этим основанием.
//
Функция ЕстьПроведеннаяОплата(Ссылка, ИсключаемаяОплата = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ИсключаемаяОплата",
		?(ЗначениеЗаполнено(ИсключаемаяОплата), ИсключаемаяОплата, Документы.Оплата.ПустаяСсылка()));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Оплата.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Оплата КАК Оплата
	|ГДЕ
	|	Оплата.Основание = &Ссылка
	|	И Оплата.Проведен
	|	И НЕ Оплата.ПометкаУдаления
	|	И Оплата.Ссылка <> &ИсключаемаяОплата";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Устанавливает признак оплаты выставленного счета.
//
// Счет записывается только при изменении признака, без перепроведения.
//
// Параметры:
//  Основание - ДокументСсылка.ВыставленныеСчета - выставленный счет.
//  Оплачено - Булево - новое значение признака.
//
Процедура УстановитьПризнакОплаты(Основание, Оплачено) Экспорт

	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат;
	КонецЕсли;

	СчетОбъект = Основание.ПолучитьОбъект();
	Если СчетОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СчетОбъект.Оплачено = Оплачено Тогда
		Возврат;
	КонецЕсли;

	СчетОбъект.Оплачено = Оплачено;
	СчетОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

#КонецОбласти
