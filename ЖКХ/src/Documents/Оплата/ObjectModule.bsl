#Область ОбработчикиСобытий

// Заполняет документ при вводе на основании выставленного счета.
//
// Параметры:
//  ДанныеЗаполнения - ДокументСсылка.ВыставленныеСчета - счет-основание.
//  СтандартнаяОбработка - Булево - признак стандартной обработки заполнения.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ВыставленныеСчета") Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыСчета = РеквизитыСчетаОснования(ДанныеЗаполнения);
	
	Основание = ДанныеЗаполнения;
	ЛицевойСчет = РеквизитыСчета.ЛицевойСчет;
	Сумма = РеквизитыСчета.СуммаКОплате;
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ЗаполняемыеРеквизиты)
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Отказ = Истина;
		ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не заполнен лицевой счет.'"), "ЛицевойСчет");
	КонецЕсли;
	
	Если Сумма <= 0 Тогда
		Отказ = Истина;
		ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Сумма оплаты должна быть больше нуля.'"), "Сумма");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Движения.Оплаты.Записывать = Истина;
	
	Движение = Движения.Оплаты.Добавить();
	Движение.Период = Дата;
	Движение.ЛицевойСчет = ЛицевойСчет;
	Движение.Сумма = Сумма;
	
	// Счет-основание помечается оплаченным; запись выполняется без перепроведения.
	Документы.ВыставленныеСчета.УстановитьПризнакОплаты(Основание, Истина);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПризнакОплатыОснования();
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПризнакОплатыОснования();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает лицевой счет и сумму к оплате по выставленному счету.
//
// Сумма к оплате = Начислено за период + (Задолженность - Оплачено).
//
// Параметры:
//  Ссылка - ДокументСсылка.ВыставленныеСчета - выставленный счет.
//
// Возвращаемое значение:
//  Структура:
//   * ЛицевойСчет - СправочникСсылка.ЛицевыеСчета - лицевой счет счета.
//   * СуммаКОплате - Число - сумма к оплате.
//
Функция РеквизитыСчетаОснования(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыставленныеСчета.ЛицевойСчет КАК ЛицевойСчет,
	|	ЕСТЬNULL(СУММА(УслугиСчета.Начислено), 0) КАК Начислено,
	|	ЕСТЬNULL(СУММА(УслугиСчета.Задолженность), 0) КАК Задолженность,
	|	ЕСТЬNULL(СУММА(УслугиСчета.Оплачено), 0) КАК Оплачено
	|ИЗ
	|	Документ.ВыставленныеСчета КАК ВыставленныеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыставленныеСчета.Услуги КАК УслугиСчета
	|		ПО УслугиСчета.Ссылка = ВыставленныеСчета.Ссылка
	|ГДЕ
	|	ВыставленныеСчета.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыставленныеСчета.ЛицевойСчет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Результат.Вставить("ЛицевойСчет", Справочники.ЛицевыеСчета.ПустаяСсылка());
	Результат.Вставить("СуммаКОплате", 0);
	
	Если Выборка.Следующий() Тогда
		Результат.ЛицевойСчет = Выборка.ЛицевойСчет;
		Результат.СуммаКОплате = Выборка.Начислено + Выборка.Задолженность - Выборка.Оплачено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Пересчитывает признак оплаты счета-основания по остальным проведенным оплатам.
// Текущая оплата исключается: при отмене проведения или удалении она еще числится проведенной.
//
Процедура ОбновитьПризнакОплатыОснования()
	
	Оплачено = Документы.ВыставленныеСчета.ЕстьПроведеннаяОплата(Основание, Ссылка);
	Документы.ВыставленныеСчета.УстановитьПризнакОплаты(Основание, Оплачено);
	
КонецПроцедуры

#КонецОбласти
