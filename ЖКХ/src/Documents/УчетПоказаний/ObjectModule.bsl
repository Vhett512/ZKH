
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ОбменДанными.Загрузка Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// регистр Показания
	Движения.Показания.Записывать = Истина;
	
	Для Каждого ТекСтрокаПоказания Из Показания Цикл
		Движение = Движения.Показания.Добавить();
		Движение.Период = Дата;
		Движение.Недвижимость = Недвижимость;
		Движение.ПриборУчета = ТекСтрокаПоказания.ПриборУчета;
		Движение.Ресурс = ТекСтрокаПоказания.ПриборУчета.ВидРесурса;
		Движение.Показание = ТекСтрокаПоказания.ЗначениеУслуги;
	КонецЦикла;
	
	// регистр ПотреблениеРесурсов
	Движения.ПотреблениеРесурсов.Записывать = Истина;
	ПредыдущиеЗначенияУслуг = ПолучитьПредыдущееЗначениеУслуги(Показания.ВыгрузитьКолонку("ПриборУчета"), Дата);
	
	Для Каждого ТекСтрокаПотреблениеРесурсов Из Показания Цикл
		
		Движение = Движения.ПотреблениеРесурсов.Добавить();
		Движение.Период = Дата;
		Движение.ПриборУчета = ТекСтрокаПотреблениеРесурсов.ПриборУчета;
		
		ПредыдущееЗначениеУслуги = ПредыдущиеЗначенияУслуг[ТекСтрокаПотреблениеРесурсов.ПриборУчета];
		
		Если ПредыдущееЗначениеУслуги = Неопределено Тогда
			
			Движение.ПотреблениеРесурса = 0;
			
		ИначеЕсли ТекСтрокаПотреблениеРесурсов.ЗначениеУслуги <= ПредыдущееЗначениеУслуги Тогда
			
			Отказ = Истина;
			
			ТекстПредупреждения = НСтр("ru = 'Значение услуги должно быть больше предыдущего значения.'");
			НовыйСообщение = Новый СообщениеПользователю;
			НовыйСообщение.Текст = ТекстПредупреждения;
			НовыйСообщение.Поле = "Показания[" + (ТекСтрокаПотреблениеРесурсов.НомерСтроки - 1) + "].ЗначениеУслуги";
			НовыйСообщение.Сообщить();
			
		Иначе
			
			Движение.ПотреблениеРесурса = ТекСтрокаПотреблениеРесурсов.ЗначениеУслуги - ПредыдущееЗначениеУслуги;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПредыдущееЗначениеУслуги(ПриборыУчета, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоказанияСрезПоследних.ПриборУчета КАК ПриборУчета,
	|	ПоказанияСрезПоследних.Показание КАК Показание
	|ИЗ
	|	РегистрСведений.Показания.СрезПоследних(ДобавитьКДате(&Дата, МЕСЯЦ, -1), ПриборУчета В (&ПриборыУчета)) КАК ПоказанияСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ПриборыУчета", ПриборыУчета);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ПредыдущиеЗначения = Новый Соответствие;
	Для Каждого СтрокаРезультата Из РезультатЗапроса Цикл
		ПредыдущиеЗначения.Вставить(СтрокаРезультата.ПриборУчета, СтрокаРезультата.Показание);
	КонецЦикла;
	
	Возврат ПредыдущиеЗначения;
	
КонецФункции

#КонецОбласти
