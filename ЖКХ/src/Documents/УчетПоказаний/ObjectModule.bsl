#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ЗаполняемыеРеквизиты)
	
	РеквизитыПриборов = ПолучитьРеквизитыПриборов(Показания.ВыгрузитьКолонку("ПриборУчета"));
	
	Для Каждого ТекСтрокаПоказания Из Показания Цикл
		
		РеквизитыПрибора = РеквизитыПриборов[ТекСтрокаПоказания.ПриборУчета];
		
		Если РеквизитыПрибора = Неопределено Тогда
			
			Отказ = Истина;
			
			ТекстПредупреждения = НСтр("ru = 'Не заполнен прибор учета.'");
			НовыйСообщение = Новый СообщениеПользователю;
			НовыйСообщение.Текст = ТекстПредупреждения;
			НовыйСообщение.Поле = "Показания[" + (ТекСтрокаПоказания.НомерСтроки - 1) + "].ПриборУчета";
			НовыйСообщение.Сообщить();
			
		Иначе
			
			Если РеквизитыПрибора.Владелец <> Недвижимость Тогда
				
				Отказ = Истина;
				
				ТекстПредупреждения = НСтр("ru = 'Прибор учета не принадлежит указанной недвижимости.'");
				НовыйСообщение = Новый СообщениеПользователю;
				НовыйСообщение.Текст = ТекстПредупреждения;
				НовыйСообщение.Поле = "Показания[" + (ТекСтрокаПоказания.НомерСтроки - 1) + "].ПриборУчета";
				НовыйСообщение.Сообщить();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Движения.Показания.Записывать = Истина;
	Движения.ПотреблениеРесурсов.Записывать = Истина;
	
	ПриборыУчета = Показания.ВыгрузитьКолонку("ПриборУчета");
	РеквизитыПриборов = ПолучитьРеквизитыПриборов(ПриборыУчета);
	ПредыдущиеЗначенияУслуг = ПолучитьПредыдущееЗначениеУслуги(ПриборыУчета, Дата);
	
	Для Каждого ТекСтрокаПоказания Из Показания Цикл
		
		РеквизитыПрибора = РеквизитыПриборов[ТекСтрокаПоказания.ПриборУчета];
		ПредыдущееЗначениеУслуги = ПредыдущиеЗначенияУслуг[ТекСтрокаПоказания.ПриборУчета];
		Ресурс = ?(ЗначениеЗаполнено(ТекСтрокаПоказания.Услуга), ТекСтрокаПоказания.Услуга, РеквизитыПрибора.ВидРесурса);
		
		Если ПредыдущееЗначениеУслуги = Неопределено Тогда
			
			ПотреблениеРесурса = 0;
			
		ИначеЕсли ТекСтрокаПоказания.ЗначениеУслуги <= ПредыдущееЗначениеУслуги Тогда
			
			// Некорректное показание: движения по строке не формируются.
			Отказ = Истина;
			
			ТекстПредупреждения = НСтр("ru = 'Значение услуги должно быть больше предыдущего значения.'");
			НовыйСообщение = Новый СообщениеПользователю;
			НовыйСообщение.Текст = ТекстПредупреждения;
			НовыйСообщение.Поле = "Показания[" + (ТекСтрокаПоказания.НомерСтроки - 1) + "].ЗначениеУслуги";
			НовыйСообщение.Сообщить();
			
			Продолжить;
			
		Иначе
			
			ПотреблениеРесурса = ТекСтрокаПоказания.ЗначениеУслуги - ПредыдущееЗначениеУслуги;
			
		КонецЕсли;
		
		// регистр Показания
		ДвижениеПоказания = Движения.Показания.Добавить();
		ДвижениеПоказания.Период = Дата;
		ДвижениеПоказания.Недвижимость = РеквизитыПрибора.Владелец;
		ДвижениеПоказания.ПриборУчета = ТекСтрокаПоказания.ПриборУчета;
		ДвижениеПоказания.Ресурс = Ресурс;
		ДвижениеПоказания.Показание = ТекСтрокаПоказания.ЗначениеУслуги;
		
		// регистр ПотреблениеРесурсов
		ДвижениеПотребления = Движения.ПотреблениеРесурсов.Добавить();
		ДвижениеПотребления.Период = Дата;
		ДвижениеПотребления.ПриборУчета = ТекСтрокаПоказания.ПриборУчета;
		ДвижениеПотребления.Ресурс = Ресурс;
		ДвижениеПотребления.ПотреблениеРесурса = ПотреблениеРесурса;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьРеквизитыПриборов(ПриборыУчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриборыУчета.Ссылка КАК ПриборУчета,
	|	ПриборыУчета.ВидРесурса КАК ВидРесурса,
	|	ПриборыУчета.Владелец КАК Владелец
	|ИЗ
	|	Справочник.ПриборыУчета КАК ПриборыУчета
	|ГДЕ
	|	ПриборыУчета.Ссылка В (&ПриборыУчета)";
	
	Запрос.УстановитьПараметр("ПриборыУчета", ПриборыУчета);
	
	РеквизитыПриборов = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Запрос.Выполнить().Выгрузить() Цикл
		РеквизитыПриборов.Вставить(СтрокаРезультата.ПриборУчета, СтрокаРезультата);
	КонецЦикла;
	
	Возврат РеквизитыПриборов;
	
КонецФункции

Функция ПолучитьПредыдущееЗначениеУслуги(ПриборыУчета, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоказанияСрезПоследних.ПриборУчета КАК ПриборУчета,
	|	ПоказанияСрезПоследних.Показание КАК Показание
	|ИЗ
	|	РегистрСведений.Показания.СрезПоследних(ДобавитьКДате(&Дата, МЕСЯЦ, -1), ПриборУчета В (&ПриборыУчета)) КАК ПоказанияСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ПриборыУчета", ПриборыУчета);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ПредыдущиеЗначения = Новый Соответствие;
	Для Каждого СтрокаРезультата Из РезультатЗапроса Цикл
		ПредыдущиеЗначения.Вставить(СтрокаРезультата.ПриборУчета, СтрокаРезультата.Показание);
	КонецЦикла;
	
	Возврат ПредыдущиеЗначения;
	
КонецФункции

#КонецОбласти
