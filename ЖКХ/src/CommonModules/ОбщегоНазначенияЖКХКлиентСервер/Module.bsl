#Область ПрограммныйИнтерфейс

// Выводит пользователю сообщение, привязанное к реквизиту или элементу формы.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//  Поле - Строка - путь к реквизиту или элементу формы, к которому привязывается
//         сообщение. Пустая строка - сообщение без привязки к полю.
//
Процедура СообщитьПользователю(Текст, Поле = "") Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если ЗначениеЗаполнено(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
