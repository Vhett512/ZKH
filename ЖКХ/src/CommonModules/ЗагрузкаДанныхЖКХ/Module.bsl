#Область ПрограммныйИнтерфейс

// Читает и проверяет файл выставленных счетов (CSV, разделитель ";").
//
// Первая строка файла - заголовок. Далее строки с колонками:
// Период;Услуга;Объем;Тариф;Начислено;Пени;Перерасчеты;Задолженность;Льготы;Оплачено
//
// Файл проверяется целиком: если есть хотя бы одна ошибка, данные не возвращаются.
//
// Параметры:
//  АдресФайла - Строка - адрес двоичных данных во временном хранилище.
//
// Возвращаемое значение:
//  Структура:
//   * Данные - ТаблицаЗначений - корректные строки файла (только при отсутствии ошибок).
//   * Ошибки - Массив из Строка - описание ошибок с номерами строк.
//
Функция ПрочитатьВыставленныеСчета(АдресФайла) Экспорт

	Данные = НоваяТаблицаДанных();
	Ошибки = Новый Массив;

	Услуги = УслугиПоНаименованию();

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДвоичныеДанные);
	Поток = Новый ПотокВПамяти(Буфер);
	Чтение = Новый ЧтениеТекста(Поток, КодировкаТекста.UTF8);

	Попытка

		// Первая строка файла - заголовок.
		Чтение.ПрочитатьСтроку();

		НомерСтроки = 1;
		Строка = Чтение.ПрочитатьСтроку();
		Пока Строка <> Неопределено Цикл

			НомерСтроки = НомерСтроки + 1;
			Если НЕ ПустаяСтрока(СтрЗаменить(Строка, ";", "")) Тогда
				ДобавитьСтрокуДанных(Данные, Ошибки, НомерСтроки, Строка, Услуги);
			КонецЕсли;
			Строка = Чтение.ПрочитатьСтроку();

		КонецЦикла;

	Исключение

		Чтение.Закрыть();
		ВызватьИсключение;

	КонецПопытки;

	Чтение.Закрыть();

	Если Ошибки.Количество() > 0 Тогда
		Данные.Очистить();
	КонецЕсли;

	Результат = Новый Структура("Данные, Ошибки", Данные, Ошибки);
	Возврат Результат;

КонецФункции

// Возвращает соответствие "наименование услуги - ссылка" по плану видов характеристик.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - наименование услуги.
//   * Значение - Характеристика.ВидыРесурсов - услуга.
//
Функция УслугиПоНаименованию() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыРесурсов.Ссылка КАК Услуга,
	|	ВидыРесурсов.Наименование КАК Наименование
	|ИЗ
	|	ПланВидовХарактеристик.ВидыРесурсов КАК ВидыРесурсов";

	Результат = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Запрос.Выполнить().Выгрузить() Цикл
		Результат.Вставить(СокрЛП(СтрокаРезультата.Наименование), СтрокаРезультата.Услуга);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает пустую таблицу данных файла.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки файла выставленных счетов.
//
Функция НоваяТаблицаДанных()

	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	Данные.Колонки.Добавить("Услуга", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыРесурсов"));
	Данные.Колонки.Добавить("Объем", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Тариф", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Начислено", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Пени", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Перерасчеты", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Задолженность", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Льготы", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Оплачено", Новый ОписаниеТипов("Число"));

	Возврат Данные;

КонецФункции

// Разбирает одну строку файла и добавляет ее в таблицу; ошибки пишет в массив.
//
// Параметры:
//  Данные - ТаблицаЗначений - таблица строк файла.
//  Ошибки - Массив из Строка - накопитель ошибок.
//  НомерСтроки - Число - номер строки файла (с учетом заголовка).
//  Строка - Строка - исходная строка файла.
//  Услуги - Соответствие из КлючИЗначение - наименование услуги и ссылка.
//
Процедура ДобавитьСтрокуДанных(Данные, Ошибки, НомерСтроки, Строка, Услуги)

	Части = СтрРазделить(Строка, ";", Ложь);

	Если Части.Количество() < 10 Тогда
		Ошибки.Добавить(СтрШаблон(
			НСтр("ru = 'Строка %1: ожидается 10 колонок, получено %2.'"),
			НомерСтроки, Части.Количество()));
		Возврат;
	КонецЕсли;

	Период = РазобратьДату(Части[0], Ошибки, НомерСтроки);
	НаименованиеУслуги = СокрЛП(Части[1]);
	Услуга = Услуги.Получить(НаименованиеУслуги);

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Услуга) Тогда
		Ошибки.Добавить(СтрШаблон(
			НСтр("ru = 'Строка %1: услуга ""%2"" не найдена в видах ресурсов.'"),
			НомерСтроки, НаименованиеУслуги));
		Возврат;
	КонецЕсли;

	НоваяСтрока = Данные.Добавить();
	НоваяСтрока.Период = Период;
	НоваяСтрока.Услуга = Услуга;
	НоваяСтрока.Объем = РазобратьЧисло(Части[2]);
	НоваяСтрока.Тариф = РазобратьЧисло(Части[3]);
	НоваяСтрока.Начислено = РазобратьЧисло(Части[4]);
	НоваяСтрока.Пени = РазобратьЧисло(Части[5]);
	НоваяСтрока.Перерасчеты = РазобратьЧисло(Части[6]);
	НоваяСтрока.Задолженность = РазобратьЧисло(Части[7]);
	НоваяСтрока.Льготы = РазобратьЧисло(Части[8]);
	НоваяСтрока.Оплачено = РазобратьЧисло(Части[9]);

	// Если объем не указан, восстанавливаем его из начисления: Начислено = Объем * Тариф.
	Если НоваяСтрока.Объем = 0 И НоваяСтрока.Тариф <> 0 Тогда
		НоваяСтрока.Объем = НоваяСтрока.Начислено / НоваяСтрока.Тариф;
	КонецЕсли;

КонецПроцедуры

// Разбирает дату формата ДД.ММ.ГГГГ; при ошибке пишет ее в массив и возвращает Неопределено.
//
// Параметры:
//  Значение - Строка - исходное значение даты.
//  Ошибки - Массив из Строка - накопитель ошибок.
//  НомерСтроки - Число - номер строки файла.
//
// Возвращаемое значение:
//  Дата, Неопределено - разобранная дата или Неопределено при ошибке.
//
Функция РазобратьДату(Значение, Ошибки, НомерСтроки)

	Результат = Неопределено;

	Части = СтрРазделить(СокрЛП(Значение), ".");

	Если Части.Количество() = 3 Тогда
		Попытка
			Результат = Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Результат = Неопределено Тогда
		Ошибки.Добавить(СтрШаблон(
			НСтр("ru = 'Строка %1: некорректная дата ""%2"" (ожидается ДД.ММ.ГГГГ).'"),
			НомерСтроки, Значение));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Разбирает число; при некорректном значении возвращает 0.
//
// Параметры:
//  Значение - Строка - исходное значение.
//
// Возвращаемое значение:
//  Число - разобранное число.
//
Функция РазобратьЧисло(Значение)

	Значение = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Значение = СтрЗаменить(Значение, ",", ".");

	ДопустимыеСимволы = "0123456789-.";
	ОчищенноеЗначение = "";
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		СимволЗначения = Сред(Значение, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволЗначения) > 0 Тогда
			ОчищенноеЗначение = ОчищенноеЗначение + СимволЗначения;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ОчищенноеЗначение) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(ОчищенноеЗначение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти
