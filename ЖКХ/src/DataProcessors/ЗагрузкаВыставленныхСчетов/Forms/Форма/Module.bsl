#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайл(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите файл с выставленными счетами'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Файлы CSV (*.csv)|*.csv|Все файлы (*.*)|*.*'");
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);

	НачатьПомещениеФайлаНаСервер(ОповещениеОЗавершении, , , , ПараметрыДиалога,
		УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите лицевой счет.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресФайла) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите файл для загрузки.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Создать документы по данным файла?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеПомещенияФайла(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт

	Если ОписаниеПомещенногоФайла = Неопределено
		ИЛИ ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = ОписаниеПомещенногоФайла.Адрес;
	Объект.ИмяФайла = ОписаниеПомещенногоФайла.СсылкаНаФайл.Имя;

КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()

	РезультатЧтения = ЗагрузкаДанныхЖКХ.ПрочитатьВыставленныеСчета(АдресФайла);

	// Вариант "все или ничего": при любой ошибке файла данные не загружаются.
	Если РезультатЧтения.Ошибки.Количество() > 0 Тогда
		ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Загрузка отменена. Найдено ошибок: %1.'"), РезультатЧтения.Ошибки.Количество()));
		Для Каждого ТекстОшибки Из РезультатЧтения.Ошибки Цикл
			ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Данные = РезультатЧтения.Данные;

	Если Данные.Количество() = 0 Тогда
		ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(НСтр("ru = 'Файл не содержит данных.'"));
		Возврат;
	КонецЕсли;

	СуществующиеДокументы = НайтиСуществующиеДокументы(Данные);
	Если СуществующиеДокументы.Количество() > 0 Тогда
		ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Загрузка отменена: за эти месяцы документы уже есть.'"));
		Для Каждого ТекстДубля Из СуществующиеДокументы Цикл
			ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(ТекстДубля);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		СозданныеДокументы = СоздатьДокументы(Данные);

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Загрузка отменена, документы не созданы. Ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;

	КонецПопытки;

	ОбщегоНазначенияЖКХКлиентСервер.СообщитьПользователю(СтрШаблон(
		НСтр("ru = 'Загружено документов: %1 (строк: %2).'"),
		СозданныеДокументы.Количество(), Данные.Количество()));

КонецПроцедуры

// Ищет уже существующие документы по лицевому счету за месяцы из файла.
//
// Параметры:
//  Данные - ТаблицаЗначений - прочитанные строки файла.
//
// Возвращаемое значение:
//  Массив из Строка - описание найденных документов.
//
&НаСервере
Функция НайтиСуществующиеДокументы(Данные)

	Месяцы = Новый Массив;
	Для Каждого СтрокаДанных Из Данные Цикл
		Месяц = НачалоМесяца(СтрокаДанных.Период);
		Если Месяцы.Найти(Месяц) = Неопределено Тогда
			Месяцы.Добавить(Месяц);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("Месяцы", Месяцы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыставленныеСчета.Ссылка КАК Ссылка,
	|	ВыставленныеСчета.Дата КАК Дата
	|ИЗ
	|	Документ.ВыставленныеСчета КАК ВыставленныеСчета
	|ГДЕ
	|	ВыставленныеСчета.ЛицевойСчет = &ЛицевойСчет
	|	И НЕ ВыставленныеСчета.ПометкаУдаления
	|	И НАЧАЛОПЕРИОДА(ВыставленныеСчета.Дата, МЕСЯЦ) В (&Месяцы)";

	Результат = Новый Массив;
	Для Каждого СтрокаРезультата Из Запрос.Выполнить().Выгрузить() Цикл
		Результат.Добавить(СтрШаблон(
			НСтр("ru = 'Документ за %1 уже существует: %2.'"),
			Формат(СтрокаРезультата.Дата, "ДЛФ=D"), Строка(СтрокаРезультата.Ссылка)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создает и проводит по одному документу на каждый месяц, представленный в данных.
//
// Параметры:
//  Данные - ТаблицаЗначений - прочитанные строки файла.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ВыставленныеСчета - созданные документы.
//
&НаСервере
Функция СоздатьДокументы(Данные)

	СтрокиПоМесяцам = Новый Соответствие;
	ПорядокМесяцев = Новый Массив;

	Для Каждого СтрокаДанных Из Данные Цикл

		Месяц = НачалоМесяца(СтрокаДанных.Период);
		СтрокиМесяца = СтрокиПоМесяцам[Месяц];

		Если СтрокиМесяца = Неопределено Тогда
			СтрокиМесяца = Новый Массив;
			СтрокиПоМесяцам.Вставить(Месяц, СтрокиМесяца);
			ПорядокМесяцев.Добавить(Месяц);
		КонецЕсли;

		СтрокиМесяца.Добавить(СтрокаДанных);

	КонецЦикла;

	СозданныеДокументы = Новый Массив;
	Для Каждого Месяц Из ПорядокМесяцев Цикл
		СозданныеДокументы.Добавить(СоздатьДокумент(Месяц, СтрокиПоМесяцам[Месяц]));
	КонецЦикла;

	Возврат СозданныеДокументы;

КонецФункции

// Создает и проводит документ за указанный месяц.
//
// Параметры:
//  Месяц - Дата - начало месяца.
//  СтрокиДанных - Массив из СтрокаТаблицыЗначений - строки файла за месяц.
//
// Возвращаемое значение:
//  ДокументСсылка.ВыставленныеСчета - созданный документ.
//
&НаСервере
Функция СоздатьДокумент(Месяц, СтрокиДанных)

	Документ = Документы.ВыставленныеСчета.СоздатьДокумент();
	Документ.Дата = Месяц;
	Документ.ЛицевойСчет = Объект.ЛицевойСчет;
	Документ.Недвижимость = ПотреблениеЖКХ.ОбъектНедвижимостиЛицевогоСчета(Объект.ЛицевойСчет);

	Для Каждого СтрокаДанных Из СтрокиДанных Цикл

		СтрокаУслуги = Документ.Услуги.Добавить();
		СтрокаУслуги.Услуга = СтрокаДанных.Услуга;
		СтрокаУслуги.Объем = СтрокаДанных.Объем;
		СтрокаУслуги.Тариф = СтрокаДанных.Тариф;
		СтрокаУслуги.Начислено = СтрокаДанных.Начислено;
		СтрокаУслуги.Пени = СтрокаДанных.Пени;
		СтрокаУслуги.Перерасчеты = СтрокаДанных.Перерасчеты;
		СтрокаУслуги.Задолженность = СтрокаДанных.Задолженность;
		СтрокаУслуги.Льготы = СтрокаДанных.Льготы;
		СтрокаУслуги.Оплачено = СтрокаДанных.Оплачено;

	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Проведение);

	Возврат Документ.Ссылка;

КонецФункции

#КонецОбласти
